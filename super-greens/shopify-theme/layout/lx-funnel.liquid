{%- comment -%} Limitless X funnel layout: no store header/footer. SEO copy per funnel page from "seo greens.docx". {%- endcomment -%}
{%- liquid
  assign seo_title = page_title
  assign seo_description = page_description
  assign seo_keywords = blank
  case template.suffix
    when 'super-greens-v1'
      assign seo_title = 'Super Greens Superfood Gummies | Daily Greens | Limitless X'
      assign seo_description = 'Get your daily greens the easy way with Limitless X Super Greens Superfood Gummies. A convenient, great-tasting way to add superfoods to your daily routine.'
      assign seo_keywords = 'super greens gummies, superfood gummies, greens gummies, daily greens, super greens supplement, superfood supplement, greens supplement, Limitless X, Super Greens Superfoods Gummies, daily superfoods'
    when 'super-greens-v2'
      assign seo_title = 'Superfood Greens Gummies for Daily Wellness | Limitless X'
      assign seo_description = 'Upgrade your daily wellness routine with Limitless X Super Greens Gummies, a convenient and delicious way to enjoy a blend of nutrient-rich superfoods every day.'
      assign seo_keywords = 'superfood greens gummies, daily wellness gummies, green superfood gummies, super greens, greens supplement gummies, superfood blend, daily greens gummies, Limitless X gummies, wellness gummies, Super Greens Gummies'
  endcase
  assign og_image = 'lx-sg-x-use-this.webp' | asset_url | prepend: 'https:'
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ seo_title }}</title>
    {%- if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
    {%- if seo_keywords != blank %}<meta name="keywords" content="{{ seo_keywords | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ seo_title | escape }}">
    {%- if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
    <meta property="og:image" content="{{ og_image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title | escape }}">
    {%- if seo_description != blank %}<meta name="twitter:description" content="{{ seo_description | escape }}">{% endif %}
    {%- if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
    <link rel="preload" href="{{ 'lx-sg-Poppins-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'lx-sg-Poppins-Bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'lx-sg-Boldonse-Regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}
  </body>
</html>
